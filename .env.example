# API Monitor — environment template
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored. Never commit real secrets.

# ---------- Database ----------
# Host port is 5433 because a native PostgreSQL already uses 5432 on this machine.
POSTGRES_USER=apimonitor
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=apimonitor
DB_PORT=5433

# Backend -> database.
# From the HOST (go run ./cmd/api):        host=localhost port=5433
# From INSIDE compose (backend container): host=db       port=5432
DATABASE_URL=postgres://apimonitor:devpassword@localhost:5433/apimonitor?sslmode=disable

# ---------- Backend ----------
PORT=8080
ENV=development

# REQUIRED. The application must refuse to start without it — a hardcoded
# fallback that reaches production lets anyone forge a token for any user.
# Generate one:  openssl rand -base64 48
JWT_SECRET=

# Exact origin. A wildcard is rejected by browsers on credentialed requests.
CORS_ORIGIN=http://localhost:3000

# ---------- Worker ----------
# Scheduler resolution, not any monitor's interval.
WORKER_TICK_SECONDS=10
# Max simultaneous outbound checks.
WORKER_CONCURRENCY=20

# ---------- Frontend ----------
# NEXT_PUBLIC_ ships this value into the browser bundle. Never prefix a secret.
NEXT_PUBLIC_API_URL=http://localhost:8080
