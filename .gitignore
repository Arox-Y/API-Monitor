# Environment — never commit real secrets. .env.example is the committed template.
.env
.env.*
!.env.example

# Go
/backend/bin/
/backend/tmp/
*.exe
*.test
*.out

# Node / Next.js (frontend/.gitignore covers its own tree too)
node_modules/
.next/
out/
build/
*.tsbuildinfo

# Test & coverage artifacts
coverage/
/frontend/playwright-report/
/frontend/test-results/

# Local dev server logs
dev.log
dev.err.log

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local planning and working documents — kept out of the public repository
/CLAUDE.md
/docs/

# Personal practice code - visible in the editor, never published
/learning/
